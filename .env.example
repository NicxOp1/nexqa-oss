# Copy to .env and fill in what you use. Every value here is optional except
# ANTHROPIC_API_KEY (for `nexqa run`) and the key of the platform you test.

# -- Claude (gene tagging, mutation, judging, simulated caller) --
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
CLAUDE_MAX_TOKENS=16000
# Simulated caller for platforms without a native test runner (short turns).
SIMULATOR_MODEL=claude-opus-5-5
SIMULATOR_EFFORT=low

# -- Voice platforms: set the one(s) you test --
RETELL_API_KEY=
VAPI_API_KEY=
ELEVENLABS_API_KEY=
BLAND_API_KEY=
SYNTHFLOW_API_KEY=
ULTRAVOX_API_KEY=
# LiveKit, Pipecat and custom harnesses use your own LLM keys, not NEXQA's.

# -- Cost guardrail --
COST_ALERT_THRESHOLD_USD=10.0
# Price of one billed test-call minute on the platform under test.
PLATFORM_PRICE_PER_MINUTE=0.12
RETELL_PRICE_PER_MINUTE=0.12

# -- Engine and storage --
ENGINE_TIMEOUT=1200
NEXQA_STORAGE_DIR=./storage
LOG_LEVEL=INFO

# -- Optional: REST API (nexqa/api) --
NEXQA_API_KEY=
ALLOWED_ORIGINS=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nexqa

# -- Optional: Airtable reporting --
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# -- Optional: review emails --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REVIEW_EMAIL_TO=

# -- Optional: webhook server (webhook_server/) --
NEXQA_WEBHOOK_BASE_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
VERIFY_SIGNATURES=true
RETELL_WEBHOOK_KEY=
CALCOM_API_KEY=
AIRTABLE_REGISTRY_BASE_ID=
ADMIN_TOKEN=
